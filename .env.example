# Zugangsdaten für den automatischen ILIAS-Login.
# Diese Datei nach .env kopieren (cp .env.example .env && chmod 600 .env) und die Werte
# direkt hinter das Gleichzeichen schreiben, ohne Anführungszeichen.
# ILIAS_USER ist die Kennung, mit der du dich auf der Login-Seite deiner Hochschule anmeldest
# (an der FH Münster die FH-Kennung, nicht die E-Mail-Adresse).
ILIAS_USER=
ILIAS_PASSWORD=
